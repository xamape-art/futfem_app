# ─── Supabase — nuevo proyecto futfem-app ─────────────────────────────────────
# Obtener en: supabase.com → Project → Settings → API
VITE_SUPABASE_URL="https://TU-PROYECTO-ID.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# ─── Modo "una sola liga" (opcional) ──────────────────────────────────────────
# Si se define, la app se bloquea a esa liga (group_path FCF) y oculta los
# selectores de competición/grupo. Útil para desplegar una app dedicada a una
# liga desde el mismo código. Déjalo vacío/sin definir para la app completa.
# Ejemplo (Tercera Federació · Grup V):
# VITE_ONLY_LEAGUE="futbol-femeni/tercera-federacio-futbol-femeni/grup-v"

# ─── Solo para el script de sync local (NUNCA va a Vercel) ────────────────────
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
